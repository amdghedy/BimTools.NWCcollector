<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(AppTargetFramework)</TargetFramework>
    <AssemblyName>BIMTools.NwcCollector.Launcher</AssemblyName>
    <RootNamespace>BIMTools.NwcCollector.Launcher</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BIMTools.NwcCollector.Core\BIMTools.NwcCollector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>..\..\..\..\..\Automation\000-DLL Native Files\Navisworks 2025\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />

    <!-- Navisworks plug-in API (plug-in + ribbon attributes). Not copied: Navisworks already has it loaded. -->
  </ItemGroup>

  <ItemGroup>
    <!-- Ribbon layout; copied to <output>\en-US\ next to the plug-in DLL. -->
    <None Include="Ribbon\en-US\BimToolsRibbon.xaml">
      <Link>en-US\BimToolsRibbon.xaml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Ready-made profiles (scenarios) and UI translations: plain text files, editable without recompiling. -->
    <None Include="Resources\Profiles\*.json">
      <Link>Profiles\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Resources\Languages\*.lang">
      <Link>Languages\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
